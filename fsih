local function triggerRecast()
if TargetScreenPos then
task.wait(2)
VirtualInputManager:SendMouseButtonEvent(TargetScreenPos.X, TargetScreenPos.Y, 0, true, game, 1)
task.wait(0.1)
VirtualInputManager:SendMouseButtonEvent(TargetScreenPos.X, TargetScreenPos.Y, 0, false, game, 1)
end
end

task.spawn(function()
while task.wait(0.1) do
if not MainFrame.Parent then break end
if isAutoFishOn and TargetScreenPos then
pcall(function()
local equippedTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
if equippedTool then
-- ส่งคำสั่งบอกเซิร์ฟเวอร์ว่าหมุนรอกตกปลา (Bypass Minigame)
netSend("reel_ended", equippedTool, true)

                local currentCount = #equippedTool:GetChildren()
                if currentCount > lastChildCount then 
                    isFishing = true
                elseif currentCount < lastChildCount and isFishing then
                    -- ปลาติดและดึงขึ้นมาแล้ว ให้ขว้างใหม่
                    isFishing = false
                    triggerRecast()
                end
                lastChildCount = currentCount
            else
                if isFishing then isFishing = false; triggerRecast() end
                lastChildCount = 0
            end
        end)
    end
end


end)

