local function netSend(...)
local Counter
for _, v in ipairs(getgc(true)) do
if typeof(v) == "table" and rawget(v, "event") and rawget(v, "func") then
Counter = v; break
end
end
if not Counter then return end
local args = { ... }
Counter.event = (Counter.event or 0) + 1
local send = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Send")
if send then send:FireServer(Counter.event, unpack(args)) end
end

